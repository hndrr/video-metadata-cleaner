{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Metadata Cleaner",
  "version": "0.1.0",
  "identifier": "com.example.video-metadata-cleaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video Metadata Cleaner",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
